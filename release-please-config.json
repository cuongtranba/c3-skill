{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "refactor", "section": "Changed" },
        { "type": "perf", "section": "Performance" },
        { "type": "docs", "section": "Documentation" },
        { "type": "build", "section": "Build" },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true }
      ],
      "extra-files": [
        { "type": "generic", "path": "skills/c3/bin/VERSION" },
        { "type": "generic", "path": "packages/cli/src/version.ts" },
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[0].version" },
        { "type": "json", "path": "packages/cli/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
